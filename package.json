{
  "name": "plz-vscode-tm",
  "displayName": "Please (TM Edition)",
  "description": "TM edition of the VS Code integrations for the Please build system",
  "author": "peter.ebden@gmail.com",
  "license": "Apache-2.0",
  "icon": "plz_128.png",
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kopachef/please-vscode"
  },
  "bugs": {
    "url": "https://github.com/kopachef/please-vscode/issues"
  },
  "publisher": "kopachef",
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [],
  "engines": {
    "vscode": "^1.52.0"
  },
  "activationEvents": [
    "workspaceContains:.plzconfig"
  ],
  "main": "./out/src/main",
  "contributes": {
    "commands": [
      {
        "command": "plz.coverage.clear",
        "title": "Clear Coverage",
        "category": "Please"
      },
      {
        "command": "plz.coverage.selectDocumentTarget",
        "title": "Cover Current File with Target...",
        "category": "Please"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "plz.coverage.clear",
          "when": "plz.coverageVisible",
          "group": "navigation@100"
        },
        {
          "command": "plz.coverage.selectDocumentTarget",
          "when": "editorLangId == go || editorLangId == python",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "properties": {
        "plz.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Please Language Server."
        },
        "please": {
          "type": "object",
          "default": {},
          "description": "User-defined code lenses for specific Please rule names.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "code_lens": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "description": "The title of the code lens."
                    },
                    "command": {
                      "type": "string",
                      "description": "The command to run (e.g. 'plz run', 'plz test', or any VS Code command)."
                    },
                    "postfix_target": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "An optional postfix or array of postfixes to append to the target name. If an array is provided, a separate CodeLens will be created for each postfix."
                    },
                    "postfixTarget": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ],
                      "description": "An optional postfix or array of postfixes to append to the target name. If an array is provided, a separate CodeLens will be created for each postfix."
                    },
                    "postfix_target_filter": {
                      "type": "string",
                      "description": "An optional filter string to match dynamically generated sub-targets via 'plz query completions'. A CodeLens will be created for each matched target."
                    },
                    "postfixTargetFilter": {
                      "type": "string",
                      "description": "An optional filter string to match dynamically generated sub-targets via 'plz query completions'. A CodeLens will be created for each matched target."
                    },
                    "terminal": {
                      "type": "boolean",
                      "description": "An optional override to force running this specific code lens in the Integrated Terminal (true) or background Output Channel (false)."
                    },
                    "Terminal": {
                      "type": "boolean",
                      "description": "An optional override to force running this specific code lens in the Integrated Terminal (true) or background Output Channel (false)."
                    },
                    "arguments": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Arguments to pass to the command. Supports referencing '${target}' or '$target'."
                    }
                  },
                  "required": [
                    "title",
                    "command"
                  ]
                }
              }
            }
          }
        },
        "please.runInTerminal": {
          "type": "boolean",
          "default": false,
          "description": "Whether to always run Please commands in the VS Code Integrated Terminal."
        },
        "please.coverage.allowedBuildDefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [],
          "description": "When non-empty, coverage runs only test targets generated by these top-level BUILD rule names, for example go_test or variant_go_test."
        }
      }
    },
    "languages": [
      {
        "id": "plz",
        "aliases": [
          "Please",
          "please"
        ],
        "filenames": [
          "BUILD"
        ],
        "extensions": [
          ".plz",
          ".build_defs",
          ".build"
        ],
        "configuration": "./syntax/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plz",
        "scopeName": "source.plz",
        "path": "./syntax/grammar.json"
      }
    ],
    "breakpoints": [
      {
        "language": "go"
      },
      {
        "language": "python"
      }
    ],
    "debuggers": [
      {
        "type": "plz-go",
        "label": "Please Go",
        "program": "./out/src/languages/go/debugAdapter.js",
        "runtime": "node",
        "languages": [
          "go"
        ]
      },
      {
        "type": "plz-python",
        "label": "Please Python",
        "languages": [
          "python"
        ]
      }
    ]
  },
  "configurationDefaults": {
    "[plz]": {
      "editor.insertSpaces": true,
      "editor.formatOnSave": true
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -b && mkdir -p out/scripts && cp -R scripts/. out/scripts/",
    "package": "node -e \"require('fs').mkdirSync('dist', { recursive: true })\" && vsce package --follow-symlinks --out dist/please-vscode-tm.vsix",
    "tm:install": "./distribution/install/please-vscode-tm.sh install",
    "tm:open": "./distribution/install/please-vscode-tm.sh open",
    "tm:status": "./distribution/install/please-vscode-tm.sh status",
    "tm:uninstall": "./distribution/install/please-vscode-tm.sh uninstall",
    "test": "npm run compile && node test/ruleCalls.test.js && node test/coverageResults.test.js && node test/coverageTargets.test.js && node test/coverageInvocation.test.js && node test/coverageAttribution.test.js && node test/coverageResultVersion.test.js && node test/coverageCommandPresentation.test.js && node test/terminalCommandLine.test.js && node test/distributionInstaller.test.js",
    "watch": "tsc -b -w",
    "prettify": "prettier --write ."
  },
  "dependencies": {
    "clipboardy": "^2.3.0",
    "json-rpc2": "^2.0.0",
    "semver": "^7.5.2",
    "tree-kill": "file:third_party/tree-kill",
    "vscode-debugadapter": "^1.47.0",
    "vscode-debugprotocol": "^1.47.0",
    "vscode-languageclient": "^7.0.0",
    "vscode-languageserver-protocol": "^3.16.0"
  },
  "devDependencies": {
    "@types/node": "^15.0.1",
    "@types/semver": "^7.3.5",
    "@types/vscode": "^1.52.0",
    "@vscode/vsce": "3.9.2",
    "prettier": "2.3.0",
    "typescript": "^4.2.4"
  }
}
